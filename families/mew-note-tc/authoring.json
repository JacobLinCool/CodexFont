  },
  "copybook_policy": {
    "required_for_every_visible_batch": true,
    "role": "identity-reference-only-no-outline-import",
    "external_reference_faces_must_be_explicitly_hash_pinned": true,
    "font_binaries_committed": false,
    "fallback_face_allowed": false,
    "missing_identity_allowed": false,
    "copybook_raster_may_become_glyph_source": false
  },
  "motif_assignment": {
    "algorithm": "For Han and eligible letter-script glyphs only, walk the frozen authoring sequence and assign tail-terminal when eligible_rank modulo 4 equals 2; assign soft-terminal to the remaining eligible glyphs and neutral-safety to technical or semantic-empty glyphs.",
    "tail_period": 4,
    "tail_phase": 2,
    "eligible_nonhan_groups": [
      "Latin letters",
      "Bopomofo",
      "Greek letters",
      "IPA letters",
      "Hiragana",
      "Katakana"
    ],
    "neutral_safety_groups": [
      "semantic-empty",
      "combining-marks",
      "box-drawing",
      "block-elements",
      "mathematical-and-technical-symbols",
      "identity-sensitive-punctuation",
      "vertical-alternates"
    ],
    "minimum_readable_text_ratio": 0.15,
    "maximum_repertoire_ratio": 0.35,
    "maximum_consecutive_tail_glyphs": 2,
    "maximum_tail_terminals_per_glyph": 1,
    "detached_contours_allowed": false,
    "spikes_allowed": false
  },
  "path_contract": {
    "batch_root": "{source_root}/pipelines/{pipeline_id}/collections/{collection_id}/batches/{batch_id}",
    "prompt": "{batch_root}/prompt.md",
    "identity_copybook": "{batch_root}/identity-copybook.png",
    "draft": "{batch_root}/draft.json",
    "raster": "{batch_root}/raster.png",
    "build": "{build_root}/pipelines/{pipeline_id}/collections/{collection_id}/batches/{batch_id}",
    "cache": "{cache_root}/pipelines/{pipeline_id}/collections/{collection_id}/batches/{batch_id}",
    "release": "{release_root}/pipelines/{pipeline_id}/collections/{collection_id}/batches/{batch_id}"
  },
  "source_boundary": {
    "clear_hand_identity_data_allowed": true,
    "clear_hand_raster_allowed": false,
    "clear_hand_outline_allowed": false,
    "clear_hand_review_allowed": false,
    "clear_hand_approval_allowed": false,
    "reference_outline_import_allowed": false,
    "generated_raster_is_never_self_approved": true
  },
  "stop_conditions": [
    "Stop if the family, pipeline, authoring, collection, repertoire, motif, prompt, pilot provenance, or pilot review hash changes.",
    "Stop if a visible batch lacks its own family-local prompt, identity copybook, draft, raster, reviewer record, or approval.",
    "Stop if any output path escapes the family, pipeline, and collection namespace.",
    "Stop if a batch uses a detached cat contour, an unassigned tail, a spike, or any Clear Hand glyph artifact.",
    "Stop if the 6,060 Han, 3,060 non-Han, 93 Hiragana, 96 Katakana, 17 semantic-empty scalars, or 93 vertical alternates are incomplete."
  ]
